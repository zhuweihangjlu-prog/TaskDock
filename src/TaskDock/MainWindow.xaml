<Window x:Class="TaskDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:TaskDock.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TaskDock" Width="440" Height="760" MinWidth="390" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource AppBackgroundBrush}" Closing="Window_Closing"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <infra:StringEqualsToVisibilityConverter x:Key="PageVisibility"/>
        <infra:StatusTextConverter x:Key="StatusText"/>
        <infra:PriorityBrushConverter x:Key="PriorityBrush"/>
        <infra:NullToVisibilityConverter x:Key="NullVisibility"/>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Margin" Value="7,2"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="NavIconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Width" Value="58"/><Setter Property="Height" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="WindowIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"/></DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="KanbanExpander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderButton" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderRoot" Background="Transparent" CornerRadius="8" Padding="4,3">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="⌄" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,2,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
                                                <Trigger Property="IsChecked" Value="False"><Setter TargetName="Arrow" Property="Text" Value="›"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Grid.Row="1" Margin="3,9,3,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarDayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DayRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="DayRoot" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.35"/></DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskCardTemplate">
            <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Margin="0,0,0,9" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{Binding Priority, Converter={StaticResource PriorityBrush}}" CornerRadius="11,0,0,11"/>
                    <Grid Grid.Column="1" Margin="11,10,8,9">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="{Binding StatusGlyph}" Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Width="30" Height="30" Padding="0" FontSize="19" Style="{StaticResource FlatButton}" ToolTip="切换状态"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="4,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers></Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Content="⋯" Width="30" Padding="0" FontSize="18" Style="{StaticResource FlatButton}" ToolTip="编辑"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="34,5,0,0">
                            <TextBlock Text="{Binding DueDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"
                                       Visibility="{Binding DueDisplay, Converter={StaticResource NullVisibility}}"/>
                            <TextBlock Text="{Binding Project, StringFormat=项目 · {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"
                                       Visibility="{Binding Project, Converter={StaticResource NullVisibility}}"/>
                            <TextBlock Text="{Binding Tags, StringFormat=# {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       Visibility="{Binding Tags, Converter={StaticResource NullVisibility}}"/>
                            <TextBlock Text="{Binding SubtaskProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="10,0,0,0"
                                       Visibility="{Binding SubtaskProgressText, Converter={StaticResource NullVisibility}}"/>
                        </WrapPanel>
                        <Grid Grid.Row="2" Margin="34,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeDisplay, StringFormat=已记录 {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding TimeDisplay, Converter={StaticResource NullVisibility}}"/>
                            <Button Grid.Column="1" Content="链接" FontSize="11" Style="{StaticResource FlatButton}" Padding="7,4" ToolTip="打开关联网页"
                                    Visibility="{Binding Link, Converter={StaticResource NullVisibility}}" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="2" Content="附件" FontSize="11" Style="{StaticResource FlatButton}" Padding="7,4" ToolTip="打开本地附件"
                                    Visibility="{Binding AttachmentPath, Converter={StaticResource NullVisibility}}" Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="3" Content="&#xE823;" Style="{StaticResource CardIconButton}" ToolTip="15 分钟后提醒"
                                    Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="4" Content="{Binding TimerGlyph}" Style="{StaticResource CardIconButton}" ToolTip="开始或暂停计时"
                                    Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="5" Content="归档" FontSize="11" Style="{StaticResource FlatButton}" Padding="7,4"
                                    Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="6" Content="删除" FontSize="11" Style="{StaticResource FlatButton}" Padding="7,4"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecycleCardTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding DeletedAt, StringFormat=删除于 {0:M月d日 HH:mm}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="恢复" Style="{StaticResource FlatButton}" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Content="彻底删除" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource FlatButton}" Command="{Binding DataContext.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ArchiveCardTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Project}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="移出归档" Style="{StaticResource FlatButton}" Command="{Binding DataContext.UnarchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Content="删除" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource FlatButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" Width="28" Height="28" CornerRadius="8"><TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="TaskDock" FontWeight="SemiBold" FontSize="15" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="PinButton" Grid.Column="1" Content="&#xE718;" ToolTip="固定面板" Style="{StaticResource WindowIconButton}" Click="PinButton_Click"/>
                    <Button x:Name="FloatButton" Grid.Column="2" Content="&#xE8A7;" ToolTip="切换普通窗口" Style="{StaticResource WindowIconButton}" Click="FloatButton_Click"/>
                    <Button Grid.Column="3" ToolTip="收起面板" Style="{StaticResource FlatButton}" Width="38" Height="38" Padding="0" Click="HideButton_Click">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Fill"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,8">
                        <Button Style="{StaticResource NavButton}" Tag="Today" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE823;" Style="{StaticResource NavIconText}"/><TextBlock Text="今天" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="All" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE8FD;" Style="{StaticResource NavIconText}"/><TextBlock Text="任务" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="Kanban" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE8A9;" Style="{StaticResource NavIconText}"/><TextBlock Text="看板" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="Calendar" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE787;" Style="{StaticResource NavIconText}"/><TextBlock Text="日历" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="History" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE81C;" Style="{StaticResource NavIconText}"/><TextBlock Text="记录" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Style="{StaticResource NavButton}" Tag="Archive" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE7B8;" Style="{StaticResource NavIconText}"/><TextBlock Text="归档" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="Recycle" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource NavIconText}"/><TextBlock Text="回收站" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                        <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Navigation_Click"><StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource NavIconText}"/><TextBlock Text="设置" Style="{StaticResource NavLabelText}"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="18,17,18,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="9,5" VerticalAlignment="Top"><TextBlock Text="{Binding PendingCount, StringFormat={}{0} 项待办}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border>
                </Grid>

                <Grid Grid.Row="1" Margin="18,0,18,12" Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Today}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="QuickInputBox" Text="{Binding QuickInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" KeyDown="QuickInput_KeyDown" ToolTip="例：明天下午3点提交周报，提前30分钟提醒"/>
                        <TextBlock Text="输入任务，例如：明天下午3点提交周报" Foreground="{DynamicResource TextSecondaryBrush}" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding QuickInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Content="＋" FontSize="20" Style="{StaticResource PrimaryButton}" Click="QuickAddButton_Click" ToolTip="快速添加任务" Padding="0"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Today}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,2,18,20">
                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,5,5">
                                        <StackPanel><TextBlock Text="逾期" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding OverdueCount}" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="5,0,0,5">
                                        <StackPanel><TextBlock Text="今天到期" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding TodayDueCount}" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,5,5,0">
                                        <StackPanel><TextBlock Text="进行中" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding InProgressCount}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="5,5,0,0">
                                        <StackPanel><TextBlock Text="今天完成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding CompletedTodayCount}" Foreground="{DynamicResource SuccessBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>
                                <StackPanel Margin="2,0,2,9"><TextBlock Text="当前工作" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="逾期、今天到期和正在进行" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                                <ItemsControl ItemsSource="{Binding TodayFocusTasks}" ItemTemplate="{StaticResource TaskCardTemplate}"/>
                                <Expander Header="今天已完成" IsExpanded="False" Style="{StaticResource KanbanExpander}" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding CompletedTodayTasks}" ItemTemplate="{StaticResource TaskCardTemplate}"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=All}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="18,0,18,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" ToolTip="搜索标题、项目、标签或备注"/>
                            <Button Grid.Column="2" Content="＋" FontSize="20" Style="{StaticResource PrimaryButton}" Click="NewTaskButton_Click" Padding="0"/>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="18,0,18,10">
                            <ComboBox x:Name="StatusFilterBox" Width="86" Padding="5" Margin="0,0,6,6" SelectionChanged="TaskFilter_Changed"><ComboBoxItem Content="全部状态" Tag="All"/><ComboBoxItem Content="待处理" Tag="Pending"/><ComboBoxItem Content="进行中" Tag="InProgress"/><ComboBoxItem Content="已完成" Tag="Completed"/></ComboBox>
                            <ComboBox x:Name="PriorityFilterBox" Width="82" Padding="5" Margin="0,0,6,6" SelectionChanged="TaskFilter_Changed"><ComboBoxItem Content="全部优先级" Tag="All"/><ComboBoxItem Content="普通" Tag="Normal"/><ComboBoxItem Content="高" Tag="High"/><ComboBoxItem Content="紧急" Tag="Urgent"/></ComboBox>
                            <ComboBox x:Name="SortBox" Width="82" Padding="5" Margin="0,0,6,6" SelectionChanged="TaskFilter_Changed"><ComboBoxItem Content="按截止时间" Tag="Due"/><ComboBoxItem Content="按优先级" Tag="Priority"/><ComboBoxItem Content="按创建时间" Tag="Created"/></ComboBox>
                            <Button Content="完成所选" Click="BatchComplete_Click" Style="{StaticResource FlatButton}" Padding="7,5" Margin="0,0,4,6"/>
                            <Button Content="删除所选" Click="BatchDelete_Click" Style="{StaticResource FlatButton}" Padding="7,5" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <ListBox x:Name="AllTaskList" Grid.Row="2" ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="18,0,18,20" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Kanban}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,0,18,18">
                                <Expander Tag="Pending" IsExpanded="True" Style="{StaticResource KanbanExpander}" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop">
                                    <Expander.Header><Grid><TextBlock Text="待处理" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingTasks.Count, StringFormat={}{0} 项}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,22,0"/></Grid></Expander.Header>
                                    <ListBox Tag="Pending" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop" ItemsSource="{Binding PendingTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" MinHeight="48" MaxHeight="320" PreviewMouseLeftButtonDown="KanbanList_PreviewMouseLeftButtonDown" PreviewMouseMove="KanbanList_PreviewMouseMove" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                                <Expander Tag="InProgress" IsExpanded="True" Style="{StaticResource KanbanExpander}" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop">
                                    <Expander.Header><Grid><TextBlock Text="进行中" FontWeight="SemiBold"/><TextBlock Text="{Binding InProgressTasks.Count, StringFormat={}{0} 项}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,22,0"/></Grid></Expander.Header>
                                    <ListBox Tag="InProgress" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop" ItemsSource="{Binding InProgressTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" MinHeight="48" MaxHeight="320" PreviewMouseLeftButtonDown="KanbanList_PreviewMouseLeftButtonDown" PreviewMouseMove="KanbanList_PreviewMouseMove" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                                <Expander Tag="Completed" IsExpanded="False" Style="{StaticResource KanbanExpander}" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop" Margin="0">
                                    <Expander.Header><Grid><TextBlock Text="已完成" FontWeight="SemiBold"/><TextBlock Text="{Binding CompletedTasks.Count, StringFormat={}{0} 项}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,22,0"/></Grid></Expander.Header>
                                    <ListBox Tag="Completed" AllowDrop="True" DragOver="KanbanSection_DragOver" Drop="KanbanSection_Drop" ItemsSource="{Binding CompletedTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" MinHeight="48" MaxHeight="320" PreviewMouseLeftButtonDown="KanbanList_PreviewMouseLeftButtonDown" PreviewMouseMove="KanbanList_PreviewMouseMove" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Calendar}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Margin="18,0,18,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="10">
                            <StackPanel>
                                <Grid Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource FlatButton}" Padding="0" ToolTip="上个月" Click="PreviousMonth_Click"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                                    <TextBlock Grid.Column="1" Text="{Binding CalendarMonthTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="0" ToolTip="下个月" Click="NextMonth_Click"><TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                                </Grid>
                                <UniformGrid Columns="7" Margin="2,0,2,4">
                                    <TextBlock Text="一" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="二" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="三" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="四" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="五" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="六" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="日" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding CalendarDays}" Height="246">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Date}" Style="{StaticResource CalendarDayButton}" Click="CalendarDay_Click" AllowDrop="True" DragOver="CalendarDay_DragOver" Drop="CalendarDay_Drop">
                                                <Grid><TextBlock Text="{Binding DayNumber}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,1,0,0"/>
                                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" MinWidth="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding TaskCountText, Converter={StaticResource NullVisibility}}">
                                                        <TextBlock Text="{Binding TaskCountText}" Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="选择日期查看任务；也可将下方任务拖到某一天" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="3,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding SelectedDateTitle}" FontSize="14" FontWeight="SemiBold" Margin="20,0,18,8"/>
                        <ListBox x:Name="CalendarTaskList" Grid.Row="2" ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Background="Transparent" BorderThickness="0" Padding="18,0,18,20" PreviewMouseLeftButtonDown="CalendarTaskList_PreviewMouseLeftButtonDown" PreviewMouseMove="CalendarTaskList_PreviewMouseMove" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=History}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ComboBox x:Name="HistoryRangeBox" Width="110" HorizontalAlignment="Left" Margin="18,0,18,10" Padding="6" SelectionChanged="HistoryRange_Changed"><ComboBoxItem Content="今天" Tag="Day"/><ComboBoxItem Content="最近7天" Tag="Week"/><ComboBoxItem Content="本月" Tag="Month"/><ComboBoxItem Content="全部记录" Tag="All"/></ComboBox>
                        <UniformGrid Grid.Row="1" Columns="2" Margin="18,0,18,12">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,0,5,5"><StackPanel><TextBlock Text="本周完成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding CompletedWeekCount}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="5,0,0,5"><StackPanel><TextBlock Text="记录耗时" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding WeekMinutes, StringFormat={}{0} 分钟}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,5,5,0"><StackPanel><TextBlock Text="今天完成" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding CompletedTodayCount}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12" Margin="5,5,0,0"><StackPanel><TextBlock Text="近30天按时率" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding CompletionRate, StringFormat={}{0}%}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="11" Margin="18,0,18,10"><StackPanel><TextBlock Text="项目分布" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/><TextBlock Text="{Binding ProjectTimeSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource TaskCardTemplate}" Margin="18,0,18,20"/></ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Archive}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource ArchiveCardTemplate}" Margin="18,0,18,20"/></ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Recycle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding VisibleTasks}" ItemTemplate="{StaticResource RecycleCardTemplate}" Margin="18,0,18,20"/></ScrollViewer>
                    </Grid>

                    <ScrollViewer Visibility="{Binding SelectedView, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,0,18,24">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="启动与行为" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="StartWithWindowsBox" Content="开机自动启动" Margin="0,5" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                    <CheckBox x:Name="AutoHideBox" Content="鼠标移开后自动收起" Margin="0,7,0,5" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                    <CheckBox x:Name="DailyReviewBox" Content="每日提醒查看任务" Margin="0,7,0,5" Checked="SettingCheckBox_Changed" Unchecked="SettingCheckBox_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="20,4,0,0"><TextBlock Text="提醒时间" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="DailyReviewTimeBox" Width="70" Margin="9,0,0,0" Style="{StaticResource InputBox}" Padding="7,4" LostKeyboardFocus="DailyReviewTime_Changed" ToolTip="24 小时格式，例如 09:00"/></StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="呼出方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="全局快捷键" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="HotkeyBox" SelectionChanged="HotkeyBox_SelectionChanged" Padding="7"><ComboBoxItem Content="Ctrl+Alt+T"/><ComboBoxItem Content="Ctrl+Shift+Space"/><ComboBoxItem Content="Win+Alt+T"/></ComboBox>
                                    <TextBlock Text="吸附显示器" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,5"/>
                                    <ComboBox x:Name="DisplayBox" DisplayMemberPath="Label" SelectedValuePath="DeviceName" SelectionChanged="DisplayBox_SelectionChanged" Padding="7"/>
                                    <TextBlock Text="自动弹出位置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,5"/>
                                    <ComboBox x:Name="DockEdgeBox" SelectionChanged="DockEdgeBox_SelectionChanged" Padding="7">
                                        <ComboBoxItem Content="屏幕右侧" Tag="Right"/>
                                        <ComboBoxItem Content="屏幕左侧" Tag="Left"/>
                                        <ComboBoxItem Content="屏幕顶部" Tag="Top"/>
                                        <ComboBoxItem Content="屏幕底部" Tag="Bottom"/>
                                    </ComboBox>
                                    <TextBlock Text="鼠标触碰所选屏幕边缘时，TaskDock 会从该方向滑出" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="主题" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged" Padding="7"><ComboBoxItem Content="跟随系统" Tag="System"/><ComboBoxItem Content="浅色" Tag="Light"/><ComboBoxItem Content="深色" Tag="Dark"/></ComboBox>
                                    <TextBlock Text="主题色" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,5"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="蓝" Tag="Blue" Click="AccentButton_Click" Style="{StaticResource FlatButton}"/><Button Content="紫" Tag="Purple" Click="AccentButton_Click" Style="{StaticResource FlatButton}"/><Button Content="青" Tag="Teal" Click="AccentButton_Click" Style="{StaticResource FlatButton}"/><Button Content="玫红" Tag="Rose" Click="AccentButton_Click" Style="{StaticResource FlatButton}"/></StackPanel>
                                    <TextBlock Text="侧边面板宽度" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,7"/>
                                    <StackPanel Orientation="Horizontal"><Button Content="紧凑" Tag="400" Click="PanelWidth_Click" Style="{StaticResource FlatButton}"/><Button Content="舒适" Tag="440" Click="PanelWidth_Click" Style="{StaticResource FlatButton}"/><Button Content="宽阔" Tag="540" Click="PanelWidth_Click" Style="{StaticResource FlatButton}"/></StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16">
                                <StackPanel><TextBlock Text="本地数据" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="数据仅保存在本机，不会产生网络请求。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,12"/>
                                    <WrapPanel><Button Content="立即备份" Click="BackupButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="恢复备份" Click="RestoreBackupButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="导出 JSON" Tag="json" Click="ExportButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="导出 CSV" Tag="csv" Click="ExportButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="导出 Markdown" Tag="md" Click="ExportButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/><Button Content="打开数据目录" Click="OpenDataFolder_Click" Style="{StaticResource FlatButton}" Margin="0,0,6,6"/></WrapPanel>
                                    <TextBlock Text="TaskDock 0.2.0 · Windows 10/11 · 完全离线" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#E91F2937" CornerRadius="10" Padding="13,8" Margin="16" Panel.ZIndex="9"
                    Visibility="{Binding ToastMessage, Converter={StaticResource NullVisibility}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="12"/><Button Content="撤销" Foreground="White" Padding="6,0" Margin="8,0,0,0" Style="{StaticResource FlatButton}" Command="{Binding UndoDeleteCommand}"/></StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
