<Window x:Class="TaskDock.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务" Width="620" Height="720" MinWidth="540" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="任务详情" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="常用信息在前，高级选项按需填写" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="标题 *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" FontSize="15"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="状态" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="StatusBox" Padding="8">
                            <ComboBoxItem Content="待处理"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PriorityBox" Padding="8">
                            <ComboBoxItem Content="低"/><ComboBoxItem Content="普通"/><ComboBoxItem Content="高"/><ComboBoxItem Content="紧急"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="截止日期" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DueDate" Padding="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="时间" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="DueTime" Style="{StaticResource InputBox}" Text="18:00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="提醒时间" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ReminderDate" Padding="6"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="项目/清单" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ProjectBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="标签（逗号分隔）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TagsBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBox x:Name="NotesBox" Style="{StaticResource InputBox}" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                <TextBlock Text="子任务（每行一项，完成项以 [x] 开头）" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBox x:Name="SubtasksBox" Style="{StaticResource InputBox}" Height="82" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="重复" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RecurrenceBox" Padding="8">
                            <ComboBoxItem Content="不重复" Tag=""/><ComboBoxItem Content="每天" Tag="daily"/>
                            <ComboBoxItem Content="每周" Tag="weekly"/><ComboBoxItem Content="每月" Tag="monthly"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="预计耗时（分钟）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="EstimateBox" Style="{StaticResource InputBox}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="链接" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBox x:Name="LinkBox" Style="{StaticResource InputBox}"/>
                <TextBlock Text="本地附件" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <DockPanel>
                    <Button Content="浏览…" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource FlatButton}" Click="BrowseAttachment_Click"/>
                    <TextBox x:Name="AttachmentBox" Style="{StaticResource InputBox}"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="88" Style="{StaticResource FlatButton}" Click="Cancel_Click"/>
            <Button Content="保存" Width="100" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
