<Window x:Class="TaskDock.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑任务" Width="680" Height="820" MinWidth="600" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="EditorCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,6,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="任务详情" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="安排时间、拆分步骤，并关联工作资料" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,5,0">
                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="标题 *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" FontSize="15"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="状态" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StatusBox"><ComboBoxItem Content="待处理"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="优先级" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityBox"><ComboBoxItem Content="低"/><ComboBoxItem Content="普通"/><ComboBoxItem Content="高"/><ComboBoxItem Content="紧急"/></ComboBox></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <TextBlock Text="时间安排" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="截止时间" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DueDateBox" Style="{StaticResource InputBox}" ToolTip="日期格式：2026-09-18"/>
                            <TextBox x:Name="DueTimeBox" Grid.Column="2" Style="{StaticResource InputBox}" ToolTip="时间格式：18:30"/>
                        </Grid>
                        <WrapPanel><Button Content="今天 18:00" Style="{StaticResource ChipButton}" Click="DueToday_Click"/><Button Content="明天 18:00" Style="{StaticResource ChipButton}" Click="DueTomorrow_Click"/><Button Content="清除截止时间" Style="{StaticResource ChipButton}" Click="ClearDue_Click"/></WrapPanel>
                        <TextBlock Text="日期格式 yyyy-MM-dd，时间格式 HH:mm，可精确到分钟" Style="{StaticResource HintText}" Margin="0,5,0,0"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>
                        <TextBlock Text="提醒时间" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReminderDateBox" Style="{StaticResource InputBox}" ToolTip="日期格式：2026-09-18"/>
                            <TextBox x:Name="ReminderTimeBox" Grid.Column="2" Style="{StaticResource InputBox}" ToolTip="时间格式：17:45"/>
                        </Grid>
                        <WrapPanel><Button Content="截止前 15 分钟" Style="{StaticResource ChipButton}" Click="Reminder15_Click"/><Button Content="截止前 1 小时" Style="{StaticResource ChipButton}" Click="Reminder60_Click"/><Button Content="清除提醒" Style="{StaticResource ChipButton}" Click="ClearReminder_Click"/></WrapPanel>
                        <TextBlock Text="提醒会通过 Windows 通知出现；必须同时填写日期和时间" Style="{StaticResource HintText}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <TextBlock Text="分类" Style="{StaticResource SectionTitle}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="项目/清单" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProjectBox" Style="{StaticResource InputBox}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="标签（逗号分隔）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TagsBox" Style="{StaticResource InputBox}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="备注" Style="{StaticResource SectionTitle}"/>
                            <Button x:Name="OpenNotesLinkButton" Grid.Column="1" Content="打开备注中的网页" Style="{StaticResource FlatButton}" Padding="8,5" Margin="0,0,0,8" Click="OpenNotesLink_Click"/>
                        </Grid>
                        <TextBox x:Name="NotesBox" Style="{StaticResource InputBox}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" TextChanged="ResourceText_Changed"/>
                        <TextBlock Text="如果备注里包含 http:// 或 https:// 地址，可用右上角按钮直接打开第一个链接" Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <TextBlock Text="子任务" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="把一项工作拆成可勾选的步骤；完成进度会显示在任务卡片上" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewSubtaskBox" Style="{StaticResource InputBox}" KeyDown="NewSubtask_KeyDown"/>
                            <Button Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButton}" Click="AddSubtask_Click"/>
                        </Grid>
                        <ItemsControl x:Name="SubtasksList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,0,6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="4"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource FlatButton}" Padding="7,4" Foreground="{DynamicResource DangerBrush}" Click="RemoveSubtask_Click" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}">
                    <StackPanel>
                        <TextBlock Text="更多设置" Style="{StaticResource SectionTitle}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="重复" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RecurrenceBox"><ComboBoxItem Content="不重复" Tag=""/><ComboBoxItem Content="每天" Tag="daily"/><ComboBoxItem Content="每周" Tag="weekly"/><ComboBoxItem Content="每月" Tag="monthly"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="预计耗时（分钟）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EstimateBox" Style="{StaticResource InputBox}"/></StackPanel>
                        </Grid>

                        <TextBlock Text="网页链接" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkBox" Style="{StaticResource InputBox}" TextChanged="ResourceText_Changed" ToolTip="可填写需求页面、文档或参考资料地址"/>
                            <Button x:Name="OpenLinkButton" Grid.Column="2" Content="打开" Style="{StaticResource FlatButton}" Click="OpenLink_Click"/>
                        </Grid>
                        <TextBlock Text="用于关联需求、文档或参考网页；任务卡片上会出现“链接”入口" Style="{StaticResource HintText}" Margin="0,6,0,0"/>

                        <TextBlock Text="本地附件" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="6"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AttachmentBox" Style="{StaticResource InputBox}" TextChanged="ResourceText_Changed" ToolTip="仅保存本机文件路径，不会复制或上传文件"/>
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource FlatButton}" Click="BrowseAttachment_Click"/>
                            <Button x:Name="OpenAttachmentButton" Grid.Column="4" Content="打开" Style="{StaticResource FlatButton}" Click="OpenAttachment_Click"/>
                        </Grid>
                        <TextBlock Text="仅保存文件路径，原文件仍留在本机；移动或删除原文件后链接会失效" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="88" Style="{StaticResource FlatButton}" Click="Cancel_Click"/>
            <Button Content="保存" Width="100" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
